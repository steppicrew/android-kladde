# Local build settings for Kladde. Copy to .env and adjust; .env is not committed.
# Shell syntax: ./gw sources this file before it runs ./gradlew.
# settings.gradle.kts reads ADX_DIR from it as well, so plain ./gradlew finds ADX too.

# JDK for Gradle. Gradle 9.6 / AGP 9.5 need JDK 21; the system default JDK 25 is rejected.
JAVA_HOME=/usr/lib/jvm/java-21-openjdk

# Android SDK. Needs platforms;android-37.2 (current AndroidX wants compileSdk 37.1 or later).
# A local.properties with sdk.dir (Android Studio writes one) takes precedence over this.
ANDROID_HOME=$HOME/Android/SDK
# Deprecated, but AGP refuses to build when it points elsewhere (the shell profile sets it).
ANDROID_SDK_ROOT=$ANDROID_HOME

# Checkout of the ADX library, built from source as a composite build.
# Relative paths are relative to this repo.
ADX_DIR=../android-apx

# Serial of the phone for adb when more than one device is connected (adb reads it).
# ANDROID_SERIAL=

# Release signing (upload key). The keystore lives outside the repo; create it once with
# ./scripts/make-keystore.sh and back it up: without it no update can ever be published.
KEYSTORE_PATH=$HOME/.android-keys/kladde-upload.jks
KEY_ALIAS=kladde-upload
KEYSTORE_PASSWORD=
# Leave empty to use KEYSTORE_PASSWORD (the scripts create the key with the store password).
KEY_PASSWORD=

# Google Play service account for ./gw publishReleaseBundle (internal track by default).
PLAY_SERVICE_ACCOUNT_JSON=$HOME/.android-keys/play-service-account.json
